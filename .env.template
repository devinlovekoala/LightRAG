################################################################################
# LightRAG .env Template for NoiseFilter-RAG Reproduction
# Complete template with all required configurations pre-commented and grouped
################################################################################

################################################################################
### 1. LLM Configuration (Choose ONE option)
################################################################################

# === Option A: OpenAI (RECOMMENDED) ===
LLM_BINDING=openai
LLM_BINDING_HOST=https://api.openai.com/v1
LLM_BINDING_API_KEY=sk-your-actual-api-key-here
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=180
OPENAI_LLM_MAX_TOKENS=9000

# === Option B: Google Gemini (Uncomment to use) ===
# LLM_BINDING=gemini
# LLM_BINDING_API_KEY=your_gemini_api_key_here
# LLM_BINDING_HOST=https://generativelanguage.googleapis.com
# LLM_MODEL=gemini-2.5-flash
# LLM_TIMEOUT=180
# GEMINI_LLM_MAX_OUTPUT_TOKENS=9000

# === Option C: Azure OpenAI (Uncomment to use) ===
# LLM_BINDING=azure_openai
# LLM_BINDING_HOST=https://your-resource.openai.azure.com/
# LLM_BINDING_API_KEY=your_azure_api_key
# LLM_MODEL=gpt-4o-mini-deployment
# AZURE_OPENAI_API_VERSION=2024-08-01-preview

# === Option D: Qwen via vLLM (Uncomment to use) ===
# LLM_BINDING=openai
# LLM_BINDING_HOST=http://your-vllm-endpoint:8000/v1
# LLM_BINDING_API_KEY=your_token
# LLM_MODEL=Qwen3-30B-Instruct
# OPENAI_LLM_MAX_TOKENS=9000

# === Option E: Ollama Local (Uncomment to use) ===
# LLM_BINDING=ollama
# LLM_BINDING_HOST=http://localhost:11434
# LLM_MODEL=qwen3.5:9b
# LLM_TIMEOUT=0
# OLLAMA_LLM_NUM_CTX=32768

################################################################################
### 2. Embedding Configuration (Choose ONE option)
################################################################################

# === Option A: OpenAI Embedding (RECOMMENDED) ===
EMBEDDING_BINDING=openai
EMBEDDING_BINDING_HOST=https://api.openai.com/v1
EMBEDDING_BINDING_API_KEY=sk-your-actual-api-key-here
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=3072
EMBEDDING_TOKEN_LIMIT=8192
EMBEDDING_SEND_DIM=false

# === Option B: Gemini Embedding (Uncomment to use) ===
# EMBEDDING_BINDING=gemini
# EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_DIM=1536
# EMBEDDING_TOKEN_LIMIT=2048
# EMBEDDING_BINDING_API_KEY=your_gemini_api_key
# EMBEDDING_BINDING_HOST=https://generativelanguage.googleapis.com
# EMBEDDING_SEND_DIM=true

# === Option C: Jina Embedding (Uncomment to use) ===
# EMBEDDING_BINDING=jina
# EMBEDDING_BINDING_HOST=https://api.jina.ai/v1/embeddings
# EMBEDDING_MODEL=jina-embeddings-v4
# EMBEDDING_DIM=2048
# EMBEDDING_BINDING_API_KEY=your_jina_api_key

# === Option D: Ollama Embedding (Uncomment to use) ===
# EMBEDDING_BINDING=ollama
# EMBEDDING_BINDING_HOST=http://localhost:11434
# EMBEDDING_MODEL=qwen3-embedding:4b
# EMBEDDING_DIM=2560
# OLLAMA_EMBEDDING_NUM_CTX=8192

################################################################################
### 3. Database Configuration (Choose ONE complete set)
################################################################################

# === Option A: PostgreSQL (RECOMMENDED for production) ===
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=your_username
POSTGRES_PASSWORD=your_password
POSTGRES_DATABASE=rag
POSTGRES_MAX_CONNECTIONS=25
POSTGRES_ENABLE_VECTOR=false
POSTGRES_VECTOR_INDEX_TYPE=HNSW

LIGHTRAG_KV_STORAGE=PGKVStorage
LIGHTRAG_DOC_STATUS_STORAGE=PGDocStatusStorage
LIGHTRAG_GRAPH_STORAGE=PGGraphStorage
LIGHTRAG_VECTOR_STORAGE=QdrantVectorDBStorage

# === Option B: MongoDB (Uncomment full set to use) ===
# MONGO_URI=mongodb://localhost:27017/
# MONGO_DATABASE=LightRAG
# 
# LIGHTRAG_KV_STORAGE=MongoKVStorage
# LIGHTRAG_DOC_STATUS_STORAGE=MongoDocStatusStorage
# LIGHTRAG_GRAPH_STORAGE=MongoGraphStorage
# LIGHTRAG_VECTOR_STORAGE=MongoVectorDBStorage

# === Option C: Neo4j + Local Storage (Uncomment to use) ===
# NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=your_password
# NEO4J_DATABASE=neo4j
# 
# LIGHTRAG_KV_STORAGE=JsonKVStorage
# LIGHTRAG_DOC_STATUS_STORAGE=JsonDocStatusStorage
# LIGHTRAG_GRAPH_STORAGE=Neo4jGraphStorage
# LIGHTRAG_VECTOR_STORAGE=NanoVectorDBStorage

# === Option D: Local JSON + NetworkX (For testing only) ===
# LIGHTRAG_KV_STORAGE=JsonKVStorage
# LIGHTRAG_DOC_STATUS_STORAGE=JsonDocStatusStorage
# LIGHTRAG_GRAPH_STORAGE=NetworkXStorage
# LIGHTRAG_VECTOR_STORAGE=NanoVectorDBStorage

################################################################################
### 4. Vector Database Configuration (if not included in storage above)
################################################################################

# === Option A: Milvus (RECOMMENDED for vector-only) ===
# MILVUS_URI=http://localhost:19530
# MILVUS_DB_NAME=lightrag
# MILVUS_INDEX_TYPE=AUTOINDEX
# MILVUS_METRIC_TYPE=COSINE
# 
# LIGHTRAG_VECTOR_STORAGE=MilvusVectorDBStorage

# === Option B: Qdrant (Uncomment to use) ===
QDRANT_URL=http://localhost:6333
QDRANT_UPSERT_MAX_PAYLOAD_BYTES=16777216

# === Option C: Redis (Uncomment to use) ===
# REDIS_URI=redis://localhost:6379
# REDIS_SOCKET_TIMEOUT=30
# REDIS_MAX_CONNECTIONS=100

################################################################################
### 5. Optional: Reranking (Improves query quality significantly)
################################################################################

# === Jina Reranker (Uncomment to enable) ===
# RERANK_BINDING=jina
# RERANK_MODEL=jina-reranker-v2-base-multilingual
# RERANK_BINDING_HOST=https://api.jina.ai/v1/rerank
# RERANK_BINDING_API_KEY=your_jina_api_key
# RERANK_BY_DEFAULT=True
# MIN_RERANK_SCORE=0.0

# === Cohere Reranker (Uncomment to enable) ===
# RERANK_BINDING=cohere
# RERANK_MODEL=rerank-v3.5
# RERANK_BINDING_HOST=https://api.cohere.com/v2/rerank
# RERANK_BINDING_API_KEY=your_cohere_api_key

################################################################################
### 6. Query Configuration (Optional tuning)
################################################################################

TOP_K=40
CHUNK_TOP_K=20
MAX_ENTITY_TOKENS=6000
MAX_RELATION_TOKENS=8000
MAX_TOTAL_TOKENS=30000
COSINE_THRESHOLD=0.2
KG_CHUNK_PICK_METHOD=VECTOR

################################################################################
### 7. Concurrency (Tune based on your setup)
################################################################################

MAX_ASYNC=4
MAX_PARALLEL_INSERT=2
# EMBEDDING_FUNC_MAX_ASYNC=8
# EMBEDDING_BATCH_NUM=10

################################################################################
### 8. Server Configuration
################################################################################

HOST=0.0.0.0
PORT=9621
WEBUI_TITLE='NoiseFilter-RAG'
WEBUI_DESCRIPTION='Noise-Aware Graph RAG System'

# Optional: Enable SSL
# SSL=true
# SSL_CERTFILE=/path/to/cert.pem
# SSL_KEYFILE=/path/to/key.pem

################################################################################
### 9. Document Processing
################################################################################

ENABLE_LLM_CACHE_FOR_EXTRACT=true
SUMMARY_LANGUAGE=English
CHUNK_SIZE=1200
CHUNK_OVERLAP_SIZE=100

################################################################################
### 10. Logging
################################################################################

LOG_LEVEL=INFO
# VERBOSE=False
# LIGHTRAG_PERFORMANCE_TIMING_LOGS=false

################################################################################
### 11. Debug / Monitoring (Optional)
################################################################################

# Enable cache
# ENABLE_LLM_CACHE=true

# Workspace isolation (optional, use when running multiple instances)
# WORKSPACE=noisefilter_exp01

################################################################################
